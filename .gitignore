# Rust
/target/
debug/
**/*.rs.bk
*.pdb
# Cargo.lock IS committed — the workspace produces a binary (slippypack-cli).

# WASM build outputs (per-crate pkg/ directories from wasm-pack)
/crates/*/pkg/

# Node / TS shell (Phase 4+)
/www/node_modules/
/www/dist/
# Build products for the browser front-end: wasm-bindgen output and the
# runtime dependencies copied out of node_modules/.
/www/pkg/
/www/vendor/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Build artifacts the CLI writes; the .hex and .upack fixtures under
# tests/fixtures/ are kept.
*.upack
*.upack.partial
!/crates/slippypack-cli/tests/fixtures/*.upack.hex
!/crates/slippypack-core/tests/fixtures/*.upack.hex
!/crates/slippypack-core/tests/fixtures/format/*.upack
!/crates/slippypack-core/tests/fixtures/e2e/*.upack
!/crates/slippypack-cli/tests/fixtures/*.upack
